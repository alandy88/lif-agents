// Everything typechecked but never emitted: the release plumbing under
// remote/scripts/, the installer test under local/install/, and the
// lif-dispatch tool under local/dispatch/ (run via strip-types, never built).
//
// A separate project rather than an entry in tsconfig.json's `include`: that
// project's `rootDir` is `remote/src`, and widening it to admit one script
// would change every emitted path under remote/dist/. Tests are included here
// (unlike the main project, which excludes them so they stay out of remote/dist/) —
// with `noEmit` there is no reason not to typecheck them.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "remote/scripts/**/*.mts",
    "local/install/*.test.mts",
    "local/dispatch/src/**/*.mts"
  ],
  "exclude": []
}
