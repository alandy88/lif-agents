{
  "promptsFile": "$LIF_NOTES_DIR/system/templates/starter-prompts.md",
  "repoIndex": "$LIF_GITHUB_DIR/personal/AGENTS.md",
  "baseSection": "base-always-on",
  "defaultRepo": "lif-notes",
  "agent": "claude",
  "classifierModel": "claude-haiku-4-5-20251001",
  "models": [
    "fable",
    "opus",
    "sonnet"
  ],
  "efforts": [
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
  ],
  "modes": {
    "explore": {
      "section": "mode-idea-exploration-general",
      "describe": "Thinking out loud, weighing options, brainstorming. No code changes.",
      "model": "opus",
      "effort": "medium",
      "domains": {
        "software": {
          "section": "domain-idea-exploration-software-engineering-ai",
          "describe": "Software, engineering, AI systems."
        },
        "visual": {
          "section": "domain-idea-exploration-art-design-visual-photography-cinematics-cgi",
          "describe": "Art, design, photography, film, CGI, image generation looks."
        }
      }
    },
    "plan": {
      "section": "mode-implementation-plan-spec-general",
      "describe": "Write an implementation plan or spec. Read code, produce a document, change nothing.",
      "model": "opus",
      "effort": "high",
      "domains": {
        "personal": {
          "section": "domain-implementation-plan-spec-peters-repos-homelab-workbench",
          "describe": "Any of Peter's own repos, the homelab, or the workbench."
        }
      }
    },
    "exec": {
      "section": "mode-execution-general",
      "describe": "Do the work: build, change, write. The task is already clear.",
      "model": "opus",
      "effort": "high",
      "domains": {
        "coding": {
          "section": "domain-execution-coding",
          "describe": "Writing or changing code."
        }
      }
    },
    "verify": {
      "section": "mode-verification-testing-general-coding-github-ops-ci",
      "describe": "Test, check, review a PR, read CI, confirm something works. Fix nothing.",
      "model": "sonnet",
      "effort": "medium",
      "domains": {}
    },
    "deploy": {
      "section": "mode-deployment",
      "describe": "Ship or install something to a machine, CI, the homelab, or Azure.",
      "model": "opus",
      "effort": "high",
      "domains": {}
    }
  }
}
