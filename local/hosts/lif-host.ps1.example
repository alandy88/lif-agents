# Environment overlay for pwsh/profile.ps1 -- copy to
# %USERPROFILE%\.config\lif-host.ps1 and fill in. This half is only read by the
# PowerShell profile; on macOS and WSL the equivalent is host.sh.
#
# Replace every REPLACE_ME -- do not guess a path, ask. See
# environments/README.md for the full key list.

$LifHost = @{
    WslDistro    = 'REPLACE_ME'       # distro the fm/fmsh/fmw bridges target
    FirstmateDir = '/home/YOUR-USER/firstmate'
    HerdrPath    = '/home/YOUR-USER/.local/bin/fm-herdr'
    StudioDir    = 'REPLACE_ME'
    NotesDir     = 'REPLACE_ME'
    ImageHubDir  = 'REPLACE_ME'
    GithubDir    = 'REPLACE_ME'
    BwsProjectId = 'REPLACE_ME'

    # Permission posture the `cc`/`ccp` Claude Code launchers use. Set a
    # `claude --permission-mode` value (auto, acceptEdits, plan, manual,
    # dontAsk, bypassPermissions) to run that mode instead of the shared
    # default, --dangerously-skip-permissions. Each launcher checks its own
    # key first, then falls back to the shared ClaudePermissionMode below,
    # then the default.
    # ClaudePermissionModeStandard = 'auto'   # cc only
    # ClaudePermissionModePersonal = 'auto'   # ccp only
    # ClaudePermissionMode = 'auto'           # shared fallback for both
}
