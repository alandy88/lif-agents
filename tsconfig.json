{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // TS 7 does not auto-include @types/*; node builtins need this explicitly.
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.mts"],
  "exclude": ["src/**/*.test.mts"]
}
