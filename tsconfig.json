{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "remote/src",
    "outDir": "remote/dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // Sources import `./x.mts` (unchanged from the donor repos, and the only
    // specifier `node --experimental-strip-types` can resolve when running the
    // tests off remote/src/). tsc rewrites them to `./x.mjs` in the emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // TS 7 does not auto-include @types/*; node builtins need this explicitly.
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["remote/src/**/*.mts"],
  "exclude": ["remote/src/**/*.test.mts"]
}
