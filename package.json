{
  "name": "@lif/sandcastle-kit",
  "version": "0.11.1",
  "description": "Repo-agnostic agent-orchestration engine for sandcastle pipelines.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alandy88/lif-agents.git"
  },
  "files": [
    "remote/dist",
    "remote/templates"
  ],
  "exports": {
    ".": "./remote/dist/index.mjs",
    "./lib/*": "./remote/dist/lib/*.mjs",
    "./phases/*": "./remote/dist/phases/*.mjs",
    "./presets/task": "./remote/dist/presets/task/index.mjs",
    "./presets/*": "./remote/dist/presets/*.mjs",
    "./templates/*": "./remote/templates/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "bun test remote/src remote/scripts local/install local/dispatch/src",
    "test:integration": "bun test remote/tests/integration"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
