# Environment overlay for pwsh/profile.ps1 -- copy to
# %USERPROFILE%\.config\lif-host.ps1 and fill in. This half is only read by the
# PowerShell profile; on macOS and WSL the equivalent is host.sh.
#
# Replace every REPLACE_ME -- do not guess a path, ask. See
# environments/README.md for the full key list.

$LifHost = @{
    FirstmateHost = 'REPLACE_ME'      # ssh target the fm/fmsh/fmw bridges use
    FirstmateDir = '/Users/YOUR-USER/firstmate'
    HerdrPath    = '/opt/homebrew/bin/herdr'
    StudioDir    = 'REPLACE_ME'
    NotesDir     = 'REPLACE_ME'
    ImageHubDir  = 'REPLACE_ME'
    GithubDir    = 'REPLACE_ME'
    BwsProjectId = 'REPLACE_ME'

    # Permission posture the `cc`/`ccp` launchers use. Each checks its own key,
    # then the shared key; unset defaults to --dangerously-skip-permissions.
    # ClaudePermissionModeStandard = 'auto'   # cc only
    # ClaudePermissionModePersonal = 'auto'   # ccp only
    # ClaudePermissionMode = 'auto'           # shared fallback
}
