#!/bin/sh
# Profile-independent BWS entrypoint for scripts and noninteractive callers.
unset BWS_ACCESS_TOKEN
if [ "$(uname -s)" = Darwin ]; then
    token=$(security find-generic-password -s lif-bws-token -w 2>/dev/null) || exit 1
else
    file=$HOME/.bws/token
    [ -r "$file" ] || { echo 'lif-bws: token is not configured' >&2; exit 1; }
    [ -z "$(find "$file" -perm /077 2>/dev/null || find "$file" -perm +077 2>/dev/null)" ] || {
        echo "lif-bws: $file must be mode 0600" >&2; exit 1;
    }
    token=$(cat "$file") || exit 1
fi
[ -n "$token" ] || exit 1
BWS_ACCESS_TOKEN=$token exec bws "$@"
